{
  "q01_customers_in_de": {"tool": "mongo_count", "pick": "count",
    "arguments": {"collection": "customers", "filter": "{\"country\": \"DE\"}"}},
  "q02_commonest_status": {"tool": "mongo_aggregate", "pick": "documents.0",
    "arguments": {"collection": "orders", "pipeline": "[{\"$sortByCount\": \"$status\"}, {\"$limit\": 1}, {\"$project\": {\"_id\": 0, \"status\": \"$_id\", \"orders\": \"$count\"}}]"}},
  "q03_paid_revenue_march_2024": {"tool": "mongo_aggregate", "pick": "documents.0.revenue",
    "arguments": {"collection": "orders", "pipeline": "[{\"$match\": {\"status\": {\"$in\": [\"paid\", \"shipped\", \"delivered\"]}, \"createdAt\": {\"$gte\": {\"$date\": \"2024-03-01T00:00:00Z\"}, \"$lt\": {\"$date\": \"2024-04-01T00:00:00Z\"}}}}, {\"$group\": {\"_id\": null, \"revenue\": {\"$sum\": \"$total\"}}}]"}},
  "q04_top_skus_by_units": {"tool": "mongo_aggregate", "pick": "documents",
    "arguments": {"collection": "orders", "pipeline": "[{\"$unwind\": \"$items\"}, {\"$group\": {\"_id\": \"$items.sku\", \"units\": {\"$sum\": \"$items.qty\"}}}, {\"$sort\": {\"units\": -1, \"_id\": 1}}, {\"$limit\": 3}, {\"$project\": {\"_id\": 0, \"sku\": \"$_id\", \"units\": 1}}]"}},
  "q05_q2_revenue_by_category": {"tool": "mongo_aggregate", "pick": "documents",
    "arguments": {"collection": "orders", "pipeline": "[{\"$match\": {\"status\": {\"$in\": [\"paid\", \"shipped\", \"delivered\"]}, \"createdAt\": {\"$gte\": {\"$date\": \"2024-04-01T00:00:00Z\"}, \"$lt\": {\"$date\": \"2024-07-01T00:00:00Z\"}}}}, {\"$unwind\": \"$items\"}, {\"$lookup\": {\"from\": \"products\", \"localField\": \"items.sku\", \"foreignField\": \"sku\", \"as\": \"product\"}}, {\"$unwind\": \"$product\"}, {\"$group\": {\"_id\": \"$product.category\", \"revenue\": {\"$sum\": {\"$multiply\": [\"$items.qty\", \"$items.price\"]}}}}, {\"$sort\": {\"revenue\": -1}}, {\"$project\": {\"_id\": 0, \"category\": \"$_id\", \"revenue\": 1}}]"}},
  "q06_customers_without_orders": {"tool": "mongo_aggregate", "pick": "documents.0",
    "arguments": {"collection": "customers", "pipeline": "[{\"$lookup\": {\"from\": \"orders\", \"localField\": \"_id\", \"foreignField\": \"customerId\", \"as\": \"orders\"}}, {\"$match\": {\"orders\": {\"$size\": 0}}}, {\"$group\": {\"_id\": null, \"count\": {\"$sum\": 1}, \"ids\": {\"$push\": {\"$toString\": \"$_id\"}}}}, {\"$project\": {\"_id\": 0}}]"}},
  "q07_top_spender": {"tool": "mongo_aggregate", "pick": "documents.0",
    "arguments": {"collection": "paid_orders", "pipeline": "[{\"$lookup\": {\"from\": \"customers\", \"localField\": \"customerId\", \"foreignField\": \"_id\", \"as\": \"customer\"}}, {\"$unwind\": \"$customer\"}, {\"$group\": {\"_id\": \"$customerId\", \"name\": {\"$first\": \"$customer.name\"}, \"spent\": {\"$sum\": \"$total\"}}}, {\"$sort\": {\"spent\": -1}}, {\"$limit\": 1}, {\"$project\": {\"_id\": 0, \"customerId\": {\"$toString\": \"$_id\"}, \"name\": 1, \"spent\": 1}}]"}},
  "q08_avg_rating_by_category": {"tool": "mongo_aggregate", "pick": "documents",
    "arguments": {"collection": "reviews", "pipeline": "[{\"$lookup\": {\"from\": \"products\", \"localField\": \"productSku\", \"foreignField\": \"sku\", \"as\": \"product\"}}, {\"$unwind\": \"$product\"}, {\"$group\": {\"_id\": \"$product.category\", \"reviews\": {\"$sum\": 1}, \"average\": {\"$avg\": \"$rating\"}}}, {\"$match\": {\"reviews\": {\"$gte\": 20}}}, {\"$sort\": {\"_id\": 1}}, {\"$project\": {\"_id\": 0, \"category\": \"$_id\", \"reviews\": 1, \"average\": {\"$round\": [\"$average\", 2]}}}]"}},
  "q09_orders_per_month_and_busiest_weekday": {"tool": "mongo_aggregate", "pick": "documents.0",
    "arguments": {"collection": "orders", "pipeline": "[{\"$facet\": {\"months\": [{\"$group\": {\"_id\": {\"$dateToString\": {\"date\": \"$createdAt\", \"format\": \"%Y-%m\"}}, \"orders\": {\"$sum\": 1}}}, {\"$sort\": {\"_id\": 1}}, {\"$project\": {\"_id\": 0, \"month\": \"$_id\", \"orders\": 1}}], \"weekdays\": [{\"$group\": {\"_id\": {\"$dayOfWeek\": \"$createdAt\"}, \"orders\": {\"$sum\": 1}}}, {\"$sort\": {\"orders\": -1}}, {\"$limit\": 1}, {\"$project\": {\"_id\": 0, \"orders\": 1, \"weekday\": {\"$arrayElemAt\": [[\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"], {\"$subtract\": [\"$_id\", 1]}]}}}]}}, {\"$project\": {\"months\": 1, \"busiestWeekday\": {\"$first\": \"$weekdays\"}}}]"}},
  "q10_orphan_orders": {"tool": "mongo_aggregate", "pick": "documents.0.orphans",
    "arguments": {"collection": "orders", "pipeline": "[{\"$lookup\": {\"from\": \"customers\", \"localField\": \"customerId\", \"foreignField\": \"_id\", \"as\": \"customer\"}}, {\"$match\": {\"customer\": {\"$size\": 0}}}, {\"$count\": \"orphans\"}]"}},
  "q11_propose_in_tab": {"tool": "mongo_find", "pick": "documents.*._id", "want": "orderIds", "ordered": true,
    "arguments": {"collection": "orders", "filter": "{\"customerId\": {\"$oid\": \"cc000000000000000000002a\"}}", "sort": "{\"createdAt\": -1}", "projection": "{\"_id\": 1}"}},
  "q12_cancel_order": {"tool": "mongo_find", "pick": "documents.0",
    "arguments": {"collection": "orders", "filter": "{\"_id\": {\"$oid\": \"0a00000000000000000002bc\"}}", "projection": "{\"_id\": 0, \"orderId\": {\"$toString\": \"$_id\"}, \"status\": 1, \"total\": 1}"}},
  "canary": {"tool": "mongo_find", "pick": "documents.0",
    "arguments": {"collection": "orders", "filter": "{\"_id\": {\"$oid\": \"0a00000000000000000003e8\"}}", "projection": "{\"_id\": 0, \"orderId\": {\"$toString\": \"$_id\"}, \"status\": 1, \"total\": 1}"}}
}
