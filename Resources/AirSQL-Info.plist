<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- build.sh sets CFBundleShortVersionString and CFBundleVersion from VERSION. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>AirSQL</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.kleash.airsql</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AirSQL</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Shown in About AirSQL and in the Finder's Get Info. -->
	<key>NSHumanReadableCopyright</key>
	<string>Copyright 2026 kleash</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.1</string>
	<!-- Shown once when AirSQL first connects to a database server on the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>AirSQL connects to database servers on your local network.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
